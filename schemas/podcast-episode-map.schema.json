{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Media Studio semantic podcast episode map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "podcast_settings_revision", "primary_audio", "transcript", "chapters"],
  "properties": {
    "schema_version": {"const": 1},
    "podcast_settings_revision": {"type": "integer", "minimum": 1},
    "primary_audio": {"$ref": "#/$defs/audio"},
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "start_ms", "end_ms", "transcript_anchor", "moments"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "transcript_anchor": {"$ref": "#/$defs/anchor"},
          "moments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "summary", "transcript_anchor"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "kind": {"enum": ["story", "definition", "list", "comparison", "reference", "claim", "summary", "call_to_action"]},
                "summary": {"type": "string", "minLength": 1},
                "transcript_anchor": {"$ref": "#/$defs/anchor"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "sha256", "duration_ms"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "duration_ms": {"type": "integer", "minimum": 1}
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "text"],
      "properties": {
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      }
    }
  }
}
